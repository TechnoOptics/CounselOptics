<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Marks this as a Wear OS app so the Play Store only serves it
         to watches. -->
    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Phase 1 uses the built-in Android app icon so the module
         builds with zero bundled binary assets; a branded Advottic
         watch icon lands in the distribution phase. -->
    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Standalone-capable: the watch app shows a useful glance on
             its own (placeholder until paired). The phone-side
             AdvotticWatch plugin pushing live case data via the
             Wearable Data Layer is an enhancement, not a requirement,
             so this stays true. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>

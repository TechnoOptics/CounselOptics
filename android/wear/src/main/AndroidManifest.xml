<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Marks this as a Wear OS app so the Play Store only serves it
         to watches. -->
    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Phase 1 uses the built-in Android app icon so the module
         builds with zero bundled binary assets; a branded Advottic
         watch icon lands in the distribution phase. -->
    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Standalone-capable: the watch app shows a useful glance on
             its own (placeholder until paired). The phone-side
             AdvotticWatch plugin pushing live case data via the
             Wearable Data Layer is an enhancement, not a requirement,
             so this stays true. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives the phone's case-summary push over the Wearable
             Data Layer ("/advottic/summary"). Must be exported with
             the DATA_CHANGED intent filter for Google Play services
             to deliver events. -->
        <service
            android:name=".SummaryListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/advottic" />
            </intent-filter>
        </service>

        <!-- Phase 3b: glanceable Tile. Bound by the system Tile host,
             so it must be exported and gated by the platform
             BIND_TILE_PROVIDER permission. No PREVIEW meta-data: a
             preview needs a bundled drawable and this module stays
             intentionally binary-asset-free until the branding pass. -->
        <service
            android:name=".SummaryTileService"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
        </service>

        <!-- Phase 3c: watch-face Complication data source. Bound by the
             system complication host, so it must be exported and gated
             by BIND_COMPLICATION_PROVIDER. SUPPORTED_TYPES advertises
             the slots we serve; UPDATE_PERIOD_SECONDS is a 30-min
             battery-friendly floor (the phone push also nudges it
             instantly via ComplicationDataSourceUpdateRequester, so the
             period is just a backstop for the day-rollover). No config
             activity: the complication needs no per-instance setup. -->
        <service
            android:name=".HearingComplicationService"
            android:label="@string/app_name"
            android:icon="@android:drawable/sym_def_app_icon"
            android:exported="true"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT" />
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="1800" />
        </service>
    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- Small Advottic brand mark for the Tile picker and complication
     slots (24dp). The old hand-drawn vector "A" was a placeholder;
     this one points at the proper columned-pillar artwork in
     drawable-nodpi/advottic_mark.png so every brand surface (email
     header, web header, watch tile, complication) shows the same
     mark. Transparent ground; the system tints it where it needs to
     (monochrome complication slots, accent-tinted tile picker). -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/advottic_mark"
    android:gravity="fill" />

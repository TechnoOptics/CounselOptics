<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: the proper Advottic pillar/columned
     mark (advottic_mark.png) instead of the previous stroked "A"
     monogram, so the watch's app-list icon matches the brand mark
     used in the email + on the web.

     Adaptive-icon math: the foreground drawable spans the full
     108dp viewport, but the system's mask (circle on Wear, rounded
     square on phones) clips everything outside the centre 66dp safe
     zone. We <inset> the bitmap by ~21dp on each side (= (108-66)/2)
     so the gold pillar artwork lands inside that safe zone in every
     mask shape Wear / Android ships.

     `gravity="fill"` on the inner bitmap stretches it to the inset
     bounds while preserving aspect (the source PNG is roughly square
     itself), so the pillar fills the safe zone tightly without
     getting cropped at the edges. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="21dp"
    android:insetTop="21dp"
    android:insetRight="21dp"
    android:insetBottom="21dp">
    <bitmap
        android:src="@drawable/advottic_mark"
        android:gravity="fill" />
</inset>

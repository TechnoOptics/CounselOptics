<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: route advottic.com/auth/callback into
                 the app's WebView instead of opening a separate browser
                 tab. Without this, magic-link emails clicked on Android
                 open in Chrome / Gmail's in-app browser, which is a
                 different cookie context from the Capacitor WebView
                 the user started in - cookies land in the wrong place
                 and they end up "signed in" only on the browser tab.

                 autoVerify="true" requires a matching
                 /.well-known/assetlinks.json file hosted at
                 https://advottic.com/.well-known/assetlinks.json with
                 our app's signing-key SHA-256 fingerprint. We host
                 that file from public/.well-known/assetlinks.json so
                 the SSL'd advottic.com origin serves it. Google's
                 verifier crawls it the first time the app installs;
                 if the fingerprint matches, all matching links open
                 directly in the app from then on. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="advottic.com" />
                <data android:pathPrefix="/auth/callback" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.advottic.com" />
                <data android:pathPrefix="/auth/callback" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Biometric sign-in (@aparajita/capacitor-biometric-auth). USE_BIOMETRIC
         is the modern API (Android 9+); USE_FINGERPRINT keeps support for
         devices that only expose the legacy fingerprint manager. Both are
         "normal" permissions, no runtime prompt needed - the biometric
         system itself handles the user-facing dialog. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
</manifest>

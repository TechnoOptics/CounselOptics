<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: route advottic.com/auth/callback into
                 the app's WebView instead of opening a separate browser
                 tab. Without this, magic-link emails clicked on Android
                 open in Chrome / Gmail's in-app browser, which is a
                 different cookie context from the Capacitor WebView
                 the user started in - cookies land in the wrong place
                 and they end up "signed in" only on the browser tab.

                 autoVerify="true" requires a matching
                 /.well-known/assetlinks.json file hosted at
                 https://advottic.com/.well-known/assetlinks.json with
                 our app's signing-key SHA-256 fingerprint. We host
                 that file from public/.well-known/assetlinks.json so
                 the SSL'd advottic.com origin serves it. Google's
                 verifier crawls it the first time the app installs;
                 if the fingerprint matches, all matching links open
                 directly in the app from then on. -->
            <!-- Broad App Links: route EVERY advottic.com / www.advottic.com
                 URL into this app instead of the default browser. The
                 previous build only matched /auth/callback, which is
                 why watch hand-offs (Open on phone, voice notes, Safe
                 Witness, timer notes) opened in Chrome. With the host
                 alone declared (no pathPrefix), any https://advottic.com
                 link the system sees - including links from the paired
                 Wear OS watch's RemoteActivityHelper - lands in this
                 app's WebView. The same assetlinks.json that authorized
                 the /auth/callback filters covers these too; the
                 verifier doesn't care about paths. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="advottic.com" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.advottic.com" />
            </intent-filter>

            <!-- Custom-scheme deep link for the OAuth callback. The
                 https App Links above work on Android, but the iOS
                 side MUST use a custom scheme (iOS suppresses Universal
                 Links back to the app that presented the in-app Safari
                 sheet). Supabase issues a single native redirectTo, so
                 we register com.advottic.app:// here as well - the
                 sign-in code path is then identical on both platforms
                 and the callback reliably returns to the app. No
                 autoVerify: custom schemes are not domain-verified. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.advottic.app" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Biometric sign-in (@aparajita/capacitor-biometric-auth). USE_BIOMETRIC
         is the modern API (Android 9+); USE_FINGERPRINT keeps support for
         devices that only expose the legacy fingerprint manager. Both are
         "normal" permissions, no runtime prompt needed - the biometric
         system itself handles the user-facing dialog. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Voice dictation (@capacitor-community/speech-recognition). RECORD_AUDIO
         is a runtime permission (the plugin requests it on first use). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Safe Witness distress alert (components/DistressOverlay.tsx) calls
         the browser's navigator.geolocation API (not a Capacitor plugin) to
         attach a live location to the alert sent to the user's emergency
         contact. Android WebView gates that API on the HOST APP's declared
         manifest permissions before it will even show its own geolocation
         prompt - without these, the call silently resolves with no
         position (the code already degrades gracefully and still sends the
         alert), quietly defeating the one thing this safety feature is
         for. Both are runtime permissions; the WebView requests them on
         first use. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Strip the Advertising ID + Privacy-Sandbox ad-services
         permissions that Google Play Services / Firebase auto-merge
         into the manifest. Advottic shows NO ads and never reads the
         advertising ID, but the merged permissions make Google Play's
         pre-review scanner detect "Device or other IDs" (advertising
         ID) collection and reject the Data safety form as inaccurate
         (rejection of version code 17). Removing the permissions at
         the merge level means the app genuinely cannot access the
         advertising ID, so the scanner stops flagging it. The
         legitimate device identifiers we do use (FCM push token,
         pairing ID) remain declared as "Device or other IDs" in the
         Data safety form. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_CUSTOM_AUDIENCE" tools:node="remove" />

    <!-- Required by Android 11+ when querying speech-recognizer
         services across packages. Without this, SpeechRecognizer
         queries return false on a stock Android 11+ install. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- AppWidgetProviderInfo for the Advottic "Open cases" widget.
     updatePeriodMillis=0: the widget is push-updated by the app via
     WidgetBridge whenever case data changes, so it never needs the
     system's (min 30-min) polling wake-ups. resizeMode horizontal|
     vertical so the user can size it from a 2x1 up. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="70dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_cases"
    android:previewLayout="@layout/widget_cases"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_cases_description" />

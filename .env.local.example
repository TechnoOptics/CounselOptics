# Copy this file to .env.local and fill in real values.
# Without ANTHROPIC_API_KEY the AI review falls back to a clearly-labeled demo response.
# Without the Supabase values the app runs in single-user local mode (JSON file storage).

# Anthropic (required for real Claude reviews)
ANTHROPIC_API_KEY=

# Supabase (required for accounts + Postgres storage; see SETUP.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for admin views only. Server-side only: never expose to the browser.
# Find at: Supabase Dashboard → Project Settings → API → "service_role" key.
SUPABASE_SERVICE_ROLE_KEY=

# Stable canonical URL for OAuth/magic-link redirects. Recommended on hosted deploys.
NEXT_PUBLIC_SITE_URL=

# Stripe (subscriptions; see SETUP.md)
STRIPE_SECRET_KEY=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Consumer 5-tier ladder (Free $0 / Starter $19 / Plus $29 / Pro $59 / Ultra $99).
# Create these with: node --env-file=.env.production.local \
#   scripts/create-personal-tier-prices.mjs   (it prints the ids to paste here).
# A rung with no price id set simply shows "Coming soon" on /billing.
STRIPE_PRICE_PERSONAL_STARTER=
STRIPE_PRICE_PERSONAL_STARTER_ANNUAL=
STRIPE_PRICE_PERSONAL_PLUS8=
STRIPE_PRICE_PERSONAL_PLUS8_ANNUAL=
STRIPE_PRICE_PERSONAL_PRO15=
STRIPE_PRICE_PERSONAL_PRO15_ANNUAL=
STRIPE_PRICE_PERSONAL_ULTRA=
STRIPE_PRICE_PERSONAL_ULTRA_ANNUAL=

# RevenueCat, server side only. The iOS app sells nothing and no longer
# bundles the RevenueCat/StoreKit plugin, so there is no client key. These two
# serve the entitlement webhook and sync routes (app/api/iap/*), which read
# whatever entitlement RevenueCat REST reports for an account.
# Server-side RevenueCat REST secret (entitlement sync). Never expose.
REVENUECAT_SECRET_KEY=
# Shared secret that authenticates RevenueCat -> /api/iap/revenuecat webhooks.
REVENUECAT_WEBHOOK_AUTH=

# Google Maps (case timeline location mapping). Enable in Google Cloud:
# Maps JavaScript API, Maps Static API, Geocoding API (billing on).
# Server key: Geocoding + server-side Static Maps for the PDF. Keep server-only.
GOOGLE_MAPS_API_KEY=
# Client key: the live map + browser static images. Restrict by HTTP referrer
# to advottic.com (and the app origin).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
